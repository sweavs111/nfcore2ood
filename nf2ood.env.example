#!/usr/bin/env bash

# nf2ood site configuration.
#
# Usage:
#   cp nf2ood.env.example nf2ood.env   # one time
#   # edit nf2ood.env with the values for your site
#   source ./nf2ood.env
#   ./nf2ood --input /path/to/pipelines --output /path/to/apps
#
# nf2ood.env is gitignored; this example file is the version checked in.
#
# Variable categories (see also: validate_environment in nf2ood):
#   REQUIRED        - nf2ood dies at startup if these are not set.
#   SOFT (warn)     - nf2ood logs a warning and falls back if unset.
#   SOFT            - nf2ood silently uses a safe cross-site default if unset.
#
# Generated apps will try to source this same file path at runtime. That only
# works if the path is also visible from the OOD host and compute nodes.
NF2OOD_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export NF2OOD_ENV_FILE="${NF2OOD_ENV_DIR}/nf2ood.env"

# ---------------------------------------------------------------------------
# REQUIRED - paths that point at site-specific filesystem locations. The
# values below are Tufts-specific examples; replace them for your site.
# ---------------------------------------------------------------------------
export NF2OOD_PIPELINE_ROOT="/cluster/tufts/apps/container/biocontainers/nf-core/pipelines"
export NF2OOD_SINGULARITY_CACHEDIR="/cluster/tufts/apps/container/biocontainers/nf-core/singularity-images"

# ---------------------------------------------------------------------------
# SOFT (warn) - if unset, nf2ood warns once and falls back to 'default'.
# Set this to the institutional nf-core profile for your site
# (see https://nf-co.re/configs/).
# ---------------------------------------------------------------------------
export NF2OOD_SLURM_PROFILE="tufts"

# ---------------------------------------------------------------------------
# SOFT - safe cross-site defaults are applied when these are unset.
# ---------------------------------------------------------------------------
export NF2OOD_CLUSTER="pax"                    # default: cluster
export NF2OOD_DEFAULT_DIRECTORY="/cluster/tufts" # default: $HOME

# NF2OOD_MODULE_NAME / NF2OOD_CONTAINER_MODULE: the environment module
# names the generated job wrapper should `module load` before running
# Nextflow. Unset -> defaults (nextflow / singularity). Set explicitly
# to "" to skip loading; useful at sites that install nextflow or
# singularity/apptainer system-wide (no module command, or modules
# named differently). The runtime wrapper also auto-skips module
# loading entirely on compute nodes that have no `module` function.
export NF2OOD_MODULE_NAME="nextflow"            # default: nextflow ("" = skip)
export NF2OOD_CONTAINER_MODULE="singularity"    # default: singularity ("" = skip)

# NF2OOD_CACHE_RESET_PATH: base path of the cache_reset sys app
# (github.com/sweavs111/ood_cache_reset) that every generated app's "Saved
# form values" notice links to. Defaults to its normal production path,
# /pun/sys/cache_reset. Override locally (e.g. to a /pun/dev/<user>/cache_reset
# sandbox deploy) while testing the utility itself, so the generated link
# always matches wherever it's actually deployed.
# export NF2OOD_CACHE_RESET_PATH="/pun/dev/<user>/cache_reset"

# NF2OOD_APPS_URL_PREFIX: base path the generated "nf-core Pipelines"
# landing page (output_dir/nf-core) links each pipeline card to, as
# <prefix>/<app-dir-name>. Defaults to the normal production apps/show
# route. Override locally (e.g. to a /pun/dev/<user> sandbox) while testing
# apps that haven't been deployed to apps/sys yet.
# export NF2OOD_APPS_URL_PREFIX="/pun/dev/<user>"

# ---------------------------------------------------------------------------
# nf-core download defaults used by download_nfcore_pipeline.sh.
# The downloader derives its install root from NF2OOD_PIPELINE_ROOT (above)
# and reuses NF2OOD_CONTAINER_MODULE for the container engine. Set
# NFCORE_ENGINE_MODULE or NFCORE_MODULE_NAME if your site loads them as
# environment modules.
# ---------------------------------------------------------------------------
# export NFCORE_ENGINE_MODULE=""
# export NFCORE_MODULE_NAME="nf-core"

# NFCORE_NXF_SYNTAX_PARSER: Nextflow config/DSL parser used by the
# `nextflow inspect` calls download_nfcore_pipeline.sh makes while fetching
# container image names. Defaults to "v1" (the legacy parser) because
# recent Nextflow releases default to a stricter parser that rejects legacy
# Groovy config helpers (e.g. `def check_max(obj, type) { ... }`) still
# shipped by many older nf-core pipeline revisions, and also eagerly
# validates includeConfig paths behind profiles that were never selected.
# Set to "" to leave Nextflow's own default parser in effect.
# export NFCORE_NXF_SYNTAX_PARSER="v1"
