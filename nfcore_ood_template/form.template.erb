---
cluster: "__NF2OOD_CLUSTER__"
form_header: |
  > **Saved form values**
  >
  > This app automatically saves your form inputs between sessions.
  >
  > To clear the saved form values for this app, use the [cache reset utility](__NF2OOD_CACHE_RESET_PATH__/?app_slug=__APP_SLUG__&return_url=/pun/sys/dashboard/batch_connect/sys/__APP_SLUG__/session_contexts/new).

attributes:
  bc_num_hours:
    label: Number of hours
    widget: number_field
    value: 8
    min: 1
    max: __NF2OOD_MAX_HOURS__
    step: 1
    help: Requested walltime for the launch job. Capped at __NF2OOD_MAX_HOURS__ hours, the cluster's maximum walltime.

__NEXTFLOW_VERSION_FIELD__

<%
  # Default working directory: NF2OOD_DEFAULT_DIRECTORY if the PUN has it,
  # else the viewing user's scratch dir, else $HOME. The scratch group comes
  # from the user's passwd entry, not ENV['GROUP']: the PUN isn't a login
  # shell (no /etc/profile.d/hpc.sh) and runs with a different gid (ncsu),
  # so neither GROUP nor the process gid names the /share/<group> dir.
  require "etc"
  nf2ood_default_workdir = ENV.fetch("NF2OOD_DEFAULT_DIRECTORY") do
    home = ENV.fetch("HOME", "/")
    begin
      pw = Etc.getpwnam(ENV.fetch("USER") { Etc.getpwuid.name })
      scratch = "/share/#{Etc.getgrgid(pw.gid).name}/#{pw.name}"
      File.directory?(scratch) ? scratch : home
    rescue StandardError
      home
    end
  end
%>
  workdir:
    label: Working directory
    widget: path_selector
    required: false
    # value: pre-fills the field; directory: only sets where the file
    # browser opens, so without value: an untouched field submits "".
    value: "<%= nf2ood_default_workdir %>"
    directory: "<%= nf2ood_default_workdir %>"
    favorites:
      - "<%= nf2ood_default_workdir %>"
      - "<%= ENV.fetch('HOME', '/') %>"
    help: |
      Directory where the Nextflow launch should run (this is where
      Nextflow's own `work/` intermediate files land, not your pipeline
      output). Defaults to your scratch directory, which is purged after
      30 days.

  use_test_profile:
    label: Run pipeline's built-in test profile
    widget: check_box
    checked_value: 1
    unchecked_value: 0
    help: |
      Launches with `-profile test`,
      using the pipeline's official minimal test dataset. Ignores all
      arguments except **outdir**. Fields marked as required still need a
      placeholder value (e.g. A space or any text). Useful for verifying that this
      app launches the pipeline correctly. 

  resume:
    label: Resume previous run
    widget: check_box
    checked_value: 1
    unchecked_value: 0
    help: Resume a previous run if a matching Nextflow work directory exists.
