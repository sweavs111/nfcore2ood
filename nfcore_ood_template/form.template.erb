---
cluster: "__NF2OOD_CLUSTER__"
form_header: |
  > **Saved form values**
  >
  > This app automatically saves your form inputs between sessions.
  >
  > To clear the saved form values for this app, use the [cache reset utility](/pun/sys/cache_reset/?app_slug=__APP_SLUG__&return_url=/pun/sys/dashboard/batch_connect/sys/__APP_SLUG__/session_contexts/new).

attributes:
  bc_num_hours:
    label: Number of hours
    widget: number_field
    value: 8
    min: 1
    step: 1
    help: Requested walltime for the launch job.

  bc_email_on_started:
    label: Email when job starts
    widget: check_box
    checked_value: 1
    unchecked_value: 0
    help: Send an email notification when the Open OnDemand launch job starts.

__NEXTFLOW_VERSION_FIELD__

<%= File.read("__NF2OOD_PARTITION_YML__").indent(2) %>

  num_cores:
    label: Number of cores
    widget: number_field
    value: 4
    min: 1
    step: 1
    help: CPU count used for single-node local execution.

  num_memory:
    label: Amount of memory (GB)
    widget: number_field
    value: 8
    min: 1
    step: 1
    help: Memory requested for single-node local execution.

  executor:
    label: Which Nextflow executor should be used?
    widget: select
    options:
      - ["slurm", "slurm", data-hide-partition: true, data-hide-num-cores: true, data-hide-num-memory: true]
      - ["local", "local"]
    help: |
      With `slurm`, the pipeline uses its configured scheduler profile.
      With `local`, tasks run on the submitted node using a generated config.

  workdir:
    label: Working directory
    widget: path_selector
    required: false
    directory: "__NF2OOD_DEFAULT_DIRECTORY__"
    favorites:
      - "__NF2OOD_DEFAULT_DIRECTORY__"
    help: Directory where the Nextflow launch should run.

  use_test_profile:
    label: Run pipeline's built-in test profile
    widget: check_box
    checked_value: 1
    unchecked_value: 0
    help: |
      Launches with `-profile test` (plus the container/scheduler profile),
      using the pipeline's official minimal test dataset instead of any
      parameter fields below — those fields are **not** passed to Nextflow
      when this is checked. Useful for verifying that this app launches the
      pipeline correctly. Fields this form marks as required (e.g. Input)
      still need a placeholder value to pass browser validation, but the
      value itself is ignored.

      The built-in test profile fetches its dataset from
      raw.githubusercontent.com at runtime, so checking this box routes the
      launch job to the `xfer` partition (the only one with outbound
      internet) instead of your selected partition.

  resume:
    label: Resume previous run
    widget: check_box
    checked_value: 1
    unchecked_value: 0
    help: Resume a previous run if a matching Nextflow work directory exists.
