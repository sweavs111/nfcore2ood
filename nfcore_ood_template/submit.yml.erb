---
batch_connect:
  template: "basic"
  conn_params:
    - working_path
    - output_log_path

script:
  job_name: "OnDemand/__PIPELINE_NAME__"
  native:
    - "--time"
    # Clamp to the site's max walltime (NF2OOD_MAX_HOURS) even if the form's
    # max: was bypassed (e.g. a stale cached value), so sbatch isn't rejected
    # by a DenyOnLimit QOS.
    - "<%= bc_num_hours.to_i.clamp(1, __NF2OOD_MAX_HOURS__) %>:00:00"
    - "--nodes"
    - "1"
    <%- if use_test_profile.to_s == "1" -%>
    # The built-in test profile (-profile test) fetches its samplesheet and
    # reference files -- and sometimes other assets hardcoded directly in a
    # pipeline's own workflow code, not just conf/test.config -- from
    # raw.githubusercontent.com at runtime. Route this launch job to xfer,
    # the one partition with outbound internet, so all of that resolves
    # normally instead of hanging on a no-internet compute node.
    - "-p"
    - "xfer"
    - "--qos"
    - "xfer"
    <%- end -%>
    - "-n"
    - "2"
    - "--mem"
    - "12G"
